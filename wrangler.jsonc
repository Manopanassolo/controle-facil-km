{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movvant",
  "main": "cloudflare-worker-entry.js",
  "compatibility_date": "2026-08-29",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
